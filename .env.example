# Port Configuration (Default: 8080)
PORT=8080

# Environment (development or production)
NODE_ENV=development

# Session Secret (Generate any random strong secret string)
SECRET=your_super_secret_session_key_here

# MongoDB Connection String (Atlas DB or local MongoDB)
# For local: mongodb://127.0.0.1:27017/wanderlust
# For MongoDB Atlas (Production): mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/wanderlust?retryWrites=true&w=majority
ATLASDB_URL=mongodb://127.0.0.1:27017/wanderlust

# Cloudinary Storage Configuration (Get from cloudinary.com dashboard)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Mapbox Access Token (Get from mapbox.com dashboard)
MAP_TOKEN=your_mapbox_public_token

# Google OAuth Configuration (Optional - get from console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Production Base URL (Set on Render, e.g. https://your-wanderlust-app.onrender.com)
BASE_URL=http://localhost:8080
